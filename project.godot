; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sci-Fi Survival Project"
run/main_scene="res://scenes/MainMenuScene.tscn"
config/features=PackedStringArray("4.6")

[autoload]

GameManager="*res://scripts/GameManager.gd"
SoundManager="*res://scripts/SoundManager.gd"
WeatherManager="*res://scripts/WeatherManager.gd"
BasePowerGrid="*res://scripts/BasePowerGrid.gd"
PowerGrid="*res://scripts/PowerGrid.gd"
SurvivalManager="*res://scripts/SurvivalManager.gd"
WeaponManager="*res://scripts/WeaponManager.gd"

[dotnet]

project/assembly_name="Alien Planet Survival 3D"

